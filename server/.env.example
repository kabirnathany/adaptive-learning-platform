# Server
NODE_ENV=development
PORT=5000

# MongoDB – pick one:
# - Local: install MongoDB, then use mongodb://localhost:27017/adaptive-learning
# - Atlas (free): https://www.mongodb.com/cloud/atlas → create cluster → Connect → get connection string, then set MONGODB_URI below (replace <password> with your DB user password)
MONGODB_URI=mongodb://localhost:27017/adaptive-learning

# JWT - generate strong random strings (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Cookie (production: set to true and use HTTPS)
COOKIE_SECURE=false
